{
  "name": "fvtt-mcp-sessionscribe",
  "version": "1.3.1",
  "description": "Session summaries and analytics for Foundry VTT dnd5e tables: an MCP server, driven by Claude Code, that turns a Craig recording and the Foundry chat log into the session record.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "build": "tsc && node esbuild.page.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "build:page": "node esbuild.page.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.3.0",
    "fvtt-mcp-dnd5e": "file:../fvtt-mcp-dnd5e",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.0.0",
    "esbuild": "~0.25.0",
    "knip": "^5.64.0",
    "typescript": "^6.0.3",
    "vitest": "~3.2.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Txpple",
  "license": "MIT",
  "keywords": [
    "foundry-vtt",
    "dnd5e",
    "mcp",
    "claude-code",
    "session-recap",
    "tabletop",
    "rpg"
  ],
  "allowScripts": {
    "esbuild": true
  }
}
