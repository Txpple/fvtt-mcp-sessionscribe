{
  "repo": "fvtt-mcp-sessionscribe",
  "description": "The contracts this server reads, each at the version its test last passed against, with the fields it touches. src/page/combat-stats.contract.test.ts reads the emitter's file from its clone beside this one and fails when a key or a field here is not in it, or the version is not the emitter's; the suite's tools/contracts.mjs --check prints every consumer's version against every emitter's. The keys are the scan's BF_KEYS (src/page/combat-stats.ts), which the test holds.",
  "consumes": [
    {
      "emitter": "fvtt-mod-bythebooks",
      "contract": "card-flags",
      "file": "contracts/card-flags.json",
      "version": 1,
      "test": "src/page/combat-stats.contract.test.ts",
      "keys": {
        "baitSwitch": ["combat", "sourceUuid"],
        "bashOffer": ["combat", "sourceUuid"],
        "bystanderRoll": ["combat", "sourceUuid"],
        "cardChip": ["combat", "sourceUuid"],
        "chipSpend": [
          "combat",
          "sourceUuid",
          "spent[].name",
          "spent[].key",
          "spent[].honoured",
          "spent[].uuid",
          "spent[].bearer"
        ],
        "clockRiders": ["combat", "sourceUuid", "riders[].label", "riders[].key"],
        "coatHit": ["combat", "sourceUuid"],
        "coatUse": ["combat", "sourceUuid"],
        "command": [
          "combat",
          "sourceUuid",
          "attackerUuid",
          "attackerName",
          "ally.uuid",
          "ally.name"
        ],
        "commandRide": ["combat", "sourceUuid"],
        "concentration": ["combat", "sourceUuid", "actorUuid", "outcome.success"],
        "conditionEnd": ["combat", "sourceUuid"],
        "d20fold": ["combat", "sourceUuid", "actorUuid", "spends[].kind", "testKind", "outcome"],
        "damageCast": ["combat", "sourceUuid"],
        "damageHold": ["combat", "sourceUuid"],
        "damageShield": [
          "combat",
          "sourceUuid",
          "rolled",
          "key",
          "total",
          "attackerUuid",
          "attackerName",
          "defenderName"
        ],
        "deathSaveOffer": ["combat", "sourceUuid"],
        "diceChange": ["combat", "sourceUuid"],
        "dropToOne": ["combat", "sourceUuid"],
        "effectReceipt": [
          "targets[].uuid",
          "targets[].effects[].sourceUuid",
          "targets[].effects[].combat"
        ],
        "emanationCard": ["combat", "sourceUuid", "key"],
        "emanationHeal": ["combat", "sourceUuid"],
        "emanationRemind": ["combat", "sourceUuid"],
        "fightingStyle": [
          "combat",
          "sourceUuid",
          "styles[].gain",
          "styles[].feature",
          "styles[].key"
        ],
        "grappleDamage": ["combat", "sourceUuid"],
        "healReroll": ["combat", "sourceUuid"],
        "hitManeuver": ["combat", "sourceUuid"],
        "hold": ["combat", "sourceUuid"],
        "holdSkipped": ["combat", "sourceUuid"],
        "initiativeGrant": ["combat", "sourceUuid"],
        "initiativeSwap": ["combat", "sourceUuid"],
        "kitTend": ["combat", "sourceUuid"],
        "mastery": ["combat", "sourceUuid"],
        "metamagic": ["combat", "sourceUuid"],
        "precision": ["combat", "sourceUuid"],
        "rebuke": ["combat", "sourceUuid"],
        "receipt": [
          "targets[].uuid",
          "targets[].name",
          "targets[].sourceUuid",
          "targets[].combat",
          "targets[].taken",
          "targets[].delta",
          "targets[].parts",
          "targets[].parts[].type",
          "targets[].parts[].amount",
          "targets[].multiplier"
        ],
        "reminder": ["combat", "sourceUuid", "honoured", "net"],
        "restSong": ["combat", "sourceUuid"],
        "riposte": ["combat", "sourceUuid"],
        "saves": ["combat", "sourceUuid", "targets[].uuid", "targets[].name", "targets[].outcome"],
        "shieldMark": ["combat", "sourceUuid"],
        "sneakDamage": ["combat", "sourceUuid"],
        "spellRiderCard": ["combat", "sourceUuid"],
        "spend": ["combat", "sourceUuid", "rows[].pool", "rows[].spent", "rows[].max"],
        "summon": ["combat", "sourceUuid"],
        "superiorityRide": ["combat", "sourceUuid", "rode"],
        "superiorityUse": ["combat", "sourceUuid"],
        "sweepCard": ["combat", "sourceUuid"],
        "topple": ["combat", "sourceUuid"],
        "transform": ["combat", "sourceUuid"],
        "useChip": ["combat", "sourceUuid"],
        "volley": ["combat", "sourceUuid"]
      }
    }
  ]
}
